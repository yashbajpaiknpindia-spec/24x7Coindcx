# Optional Binance API credentials. Use READ-ONLY permissions and IP restrictions.
# Keep these in Render Environment, never commit real values.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Automatic, bounded background discovery and leader-trade analysis.
ENABLE_SCHEDULER=true
MONITOR_INTERVAL_MINUTES=30
SCHEDULED_PAGES_PER_MODE=3
SCHEDULED_HISTORY_BATCH=10
SCHEDULED_PATH_BATCH=10

# Set only when a durable PostgreSQL database is provisioned for this app.
DATABASE_URL=
