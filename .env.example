# Required for a deployed environment
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DATABASE_URL=sqlite:///./coindcx_terminal.db

# CoinDCX credentials: store only in Render environment variables. Never paste them into chat.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Mode: live mode and automated live trading are both disabled unless explicitly enabled.
LIVE_TRADING_ENABLED=false
AUTO_LIVE_TRADING_ENABLED=false
LIVE_MAX_LEVERAGE=2
LIVE_MAX_ORDER_NOTIONAL_USDT=25
LIVE_MAX_GROSS_EXPOSURE_USDT=100
LIVE_MAX_DAILY_LOSS_INR=500

# Strategy defaults / paper assumptions
STARTING_CAPITAL_INR=30000
INR_PER_USDT=94.75
DEFAULT_FUTURES_LEVERAGE=1
FUTURES_TAKER_FEE_PCT=0.075
SPOT_TAKER_FEE_PCT=0.15
NORMAL_SLIPPAGE_PCT=0.05
STRESS_SLIPPAGE_PCT=0.12
MIN_QUOTE_TURNOVER_USDT=250000
MAX_SPREAD_BPS=50
MARKET_DATA_POLL_SECONDS=60
STRATEGY_REBALANCE_HOURS=24

# Account-wide futures fill reconciliation (rolling lookback; capped and visibly warned)
LIVE_FUTURES_TRADE_SYNC_SECONDS=300
LIVE_FUTURES_TRADE_SYNC_DAYS=3
LIVE_FUTURES_TRADES_MAX_PAGES_PER_PAIR=5

# Research scanner and paper mode
SCAN_UNIVERSE_LIMIT=60
AUTO_START_PAPER=true
# Each research-mode paper signal uses this notional; it is independent of starting capital.
PAPER_RESEARCH_NOTIONAL_USDT=1000
